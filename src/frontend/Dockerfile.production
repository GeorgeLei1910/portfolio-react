# Single image: nginx (PM2) + Node API — build from repository root (see docker-compose.production.yml)
FROM node:18-slim

RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    sqlite3 \
    libsqlite3-dev \
    nginx \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pm2

# Frontend (CRA expects package.json + public/ + src/ under /app/frontend)
WORKDIR /app/frontend
COPY src/frontend/package*.json ./
RUN npm ci
COPY src/frontend/ ./
COPY public/ ./public/

ARG REACT_APP_API_URL=/api
ENV REACT_APP_API_URL=$REACT_APP_API_URL
RUN npm run build

# Backend
WORKDIR /app/backend
COPY src/backend/package*.json ./
RUN npm install
RUN npm rebuild better-sqlite3 --build-from-source
COPY src/backend/ ./

WORKDIR /app
RUN cp -r /app/frontend/build/* /usr/share/nginx/html/

COPY src/frontend/nginx.monolith.conf /etc/nginx/nginx.conf
COPY src/frontend/ecosystem.config.js ./

RUN mkdir -p logs

EXPOSE 80

CMD ["pm2-runtime", "start", "ecosystem.config.js"]
